# Copie para .env e ajuste conforme necessário.

VITE_API_BASE_URL=http://localhost:8080

# Login (Keycloak, ver o README do akpedia-server). Os defaults servem para o ambiente local.
# Keycloak: por padrão, /auth no mesmo endereço do app (atrás do nginx).
# VITE_KEYCLOAK_URL=http://localhost/auth
VITE_KEYCLOAK_REALM=akpedia
VITE_KEYCLOAK_CLIENT_ID=akpedia-client
