# Copie para .env e ajuste conforme necessário.

VITE_API_BASE_URL=http://localhost:8080

# Autor atribuído a cada upload enquanto não há cadastro nem login (ver "Usuario padrao" no
# README do akpedia-server). O id é de sequência e muda de banco para banco -- confira o seu:
#   docker compose exec db psql -U akpedia -d akpedia \
#     -c "SELECT id FROM users WHERE email = 'aprovador@akpedia.local'"
VITE_DEFAULT_USER_ID=1
